{
    "name": "@chordproject/parser",
    "version": "1.2.0",
    "type": "module",
    "module": "dist/index.js",
    "main": "dist/index.cjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./style.css": "./src/style.css"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src/style.css"
    ],
    "description": "A TypeScript library for parsing and formatting ChordPro songs.",
    "repository": {
        "type": "git",
        "url": "https://github.com/chordproject/chordproject-parser.git"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "license": "AGPL-3.0-only",
    "keywords": [
        "chordpro",
        "chordproject",
        "parser",
        "chord",
        "guitar"
    ],
    "scripts": {
        "dev": "lsof -tiTCP:8081 -sTCP:LISTEN | xargs -r kill 2>/dev/null; vite demo --port 8081 --strictPort",
        "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
        "build:demo": "vite build demo --outDir ../demo-dist",
        "release": "npm run release:patch",
        "release:patch": "npm run test:ci && npm version patch && git push --follow-tags",
        "release:minor": "npm run test:ci && npm version minor && git push --follow-tags",
        "release:major": "npm run test:ci && npm version major && git push --follow-tags",
        "release:current": "npm run test:ci && git tag -a v$npm_package_version -m \"Release v$npm_package_version\" && git push --follow-tags",
        "test": "npx jest --runInBand --detectOpenHandles --colors --verbose --reporters=default",
        "test:ci": "npx jest --ci --runInBand --silent --colors --coverage"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^24.0.1",
        "jest": "^30.0.0",
        "ts-jest": "^29.4.0",
        "tsup": "^8.3.5",
        "typescript": "^5.8.3",
        "vite": "^6.0.7"
    }
}
