{
    "name": "@chordproject/parser",
    "version": "1.1.0",
    "type": "module",
    "module": "dist/index.js",
    "main": "dist/index.cjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./style.css": "./src/style.css"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src/style.css"
    ],
    "description": "A TypeScript library for parsing and formatting ChordPro songs.",
    "license": "AGPL-3.0-only",
    "keywords": [
        "chordpro",
        "chordproject",
        "parser",
        "chord",
        "guitar"
    ],
    "scripts": {
        "dev": "lsof -tiTCP:8081 -sTCP:LISTEN | xargs -r kill 2>/dev/null; vite demo --port 8081 --strictPort",
        "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
        "build:demo": "vite build demo --outDir ../demo-dist",
        "release": "npm run build && npm publish",
        "test": "npx jest --runInBand --detectOpenHandles --colors --verbose --reporters=default",
        "test:ci": "npx jest --ci --runInBand --silent --colors --coverage"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^24.0.1",
        "jest": "^30.0.0",
        "ts-jest": "^29.4.0",
        "tsup": "^8.3.5",
        "typescript": "^5.8.3",
        "vite": "^6.0.7"
    }
}
